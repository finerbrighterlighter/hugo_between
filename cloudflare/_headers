# Cloudflare port of the [[headers]] in netlify.toml. Keep the two in step
# until Netlify is retired; the CSP rationale is in the comments there.
# build.sh copies this file into public/.
#
# Two differences from Netlify's matching:
# - A rule allows one splat, so netlify.toml's `*_hu_*` becomes `*_hu_:hash`
#   (the placeholder takes the hash and extension, `c9b5…1f3d.webp`).
# - A header set by several matching rules is joined with a comma, so a more
#   specific rule detaches the broader Cache-Control (`! Cache-Control`) first.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://gc.zgo.at https://cdn.jsdelivr.net/npm/mermaid@11/; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; media-src 'self'; connect-src 'self' https://api.github.com https://api.openalex.org https://api.unsplash.com https://doi.org https://api.crossref.org https://data.crossref.org https://api.datacite.org https://data.datacite.org https://data.medra.org https://graphql.anilist.co https://api.simkl.com https://ws.audioscrobbler.com https://gc.zgo.at https://stats.htunteza.com; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; manifest-src 'self'

/css/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=3600

/images/*
  Cache-Control: public, max-age=604800

# Hugo writes a content hash into every processed image (`name_hu_<hash>.webp`).
/images/*_hu_:hash
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/posts/*_hu_:hash
  Cache-Control: public, max-age=31536000, immutable

/blood-records/*_hu_:hash
  Cache-Control: public, max-age=31536000, immutable

/works/*_hu_:hash
  Cache-Control: public, max-age=31536000, immutable

/general/cv/*
  Cache-Control: public, max-age=86400

/general/cv_short/*
  Cache-Control: public, max-age=86400

# netlify.toml also sets no-store on the two old transcript PDFs. Here
# _redirects sends both away before any asset is served, so they need no rule.
/general/documents/d6e5609a2d5acdbcd5627a56cdb2ea50.pdf
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, noarchive, nosnippet

/general/documents/7bc4ddb932d5a4c51da057b82c090cc7.pdf
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, noarchive, nosnippet

/general/documents/f352169ae815889e3481d279c88d2f66.pdf
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, noarchive, nosnippet

/general/documents/4ad88c41e7c43a11d646f51448fbe218.pdf
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, noarchive, nosnippet
