{
  // Cloudflare Workers static-assets deploy, following
  // https://gohugo.io/host-and-deploy/deploy-to-cloudflare/
  // Headers and redirects live in static/_headers and static/_redirects.
  "name": "hugo-between",
  "compatibility_date": "2026-10-20",
  "build": {
    "command": "chmod a+x build.sh && ./build.sh"
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
